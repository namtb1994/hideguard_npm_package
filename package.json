{
  "name": "@hachitechs/hideguard",
  "version": "0.9.0",
  "description": "Framework-independent HideGuard verdict client, verification and access lifecycle",
  "author": "Hachitechs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namtb1994/hideguard_npm_package.git"
  },
  "homepage": "https://github.com/namtb1994/hideguard_npm_package#readme",
  "bugs": {
    "url": "https://github.com/namtb1994/hideguard_npm_package/issues"
  },
  "keywords": [
    "hideguard",
    "verification",
    "ed25519",
    "access-control",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser/index.d.ts"
      ]
    }
  },
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "src/verdict-policy.json",
    "scripts/config.mjs",
    "src/api-url.ts"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./verdict-policy.json": "./src/verdict-policy.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run test:integration",
    "config": "node scripts/config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
