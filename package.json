{
  "name": "@hachitechs/hideguard",
  "version": "0.8.0",
  "description": "Framework-independent HideGuard verdict client, verification and access lifecycle",
  "keywords": [
    "hideguard",
    "verification",
    "ed25519",
    "access-control",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser/index.d.ts"
      ]
    }
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "docs",
    "src/verdict-policy.json"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./verdict-policy.json": "./src/verdict-policy.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:integration"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "typescript": "5.9.3"
  },
  "private": true
}
